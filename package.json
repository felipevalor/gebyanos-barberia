{
  "name": "gebyanos-barberia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy --define __VERSION__:\"'\"$(git rev-parse --short HEAD)\"'\" --define __DEPLOYED_AT__:\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply barberia --local",
    "db:migrate:remote": "wrangler d1 migrations apply barberia --remote",
    "db:seed:local": "wrangler d1 execute barberia --local --file=./src/db/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "libphonenumber-js": "^1.13.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
